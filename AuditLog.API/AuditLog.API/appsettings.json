{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Mode": "Local",
    "Authority": "https://login.microsoftonline.com/local",
    "Issuer": "AuditLog.Local",
    "Audience": "audit-log-api",
    "TokenLifetimeMinutes": "60"
  },
  "AuditRetention": {
    "RetentionDays": 365
  },
  "AuditRedaction": {
    "SensitiveFields": [
      "email",
      "phone",
      "password",
      "accessToken",
      "refreshToken",
      "creditCardNumber"
    ],
    "ReplacementValue": "[REDACTED]"
  },
  "ConnectionStrings": {
    "AuditLogDb": "Server=(LocalDB)\\MSSQLLocalDB;Database=AuditLogDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;"
  }
}
